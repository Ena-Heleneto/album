{
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dev",
  "runServices": ["rustfs", "redis", "mongodb", "dozzle"],
  "workspaceFolder": "/workspaces/app",
   "postCreateCommand": "npx pnpm i",
  "postStartCommand": "chown -R 1000:1000 .devcontainer/docker_volumes/rustfs || true",
  "remoteUser": "root",
  "shutdownAction": "stopCompose"
}
